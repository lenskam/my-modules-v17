<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_instance_alert_template" model="ir.actions.act_window">
        <field name="name">Modèles d'alerte</field>
        <field name="res_model">instance.alert.template</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_instance_alert_template_tree" model="ir.ui.view">
        <field name="name">instance.alert.template.tree</field>
        <field name="model">instance.alert.template</field>
        <field name="arch" type="xml">
            <tree string="Modèles d'alerte">
                <field name="name"/>
                <field name="type" widget="badge"
                       decoration-info="type == 'reminder'"
                       decoration-danger="type == 'suspension'"/>
                <field name="trigger_days"/>
                <field name="subject" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_instance_alert_template_form" model="ir.ui.view">
        <field name="name">instance.alert.template.form</field>
        <field name="model">instance.alert.template</field>
        <field name="arch" type="xml">
            <form string="Modèle d'alerte">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="type"/>
                            <field name="trigger_days" invisible="type == 'suspension'"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="subject"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Corps du message" name="body">
                            <field name="body" nolabel="1" rows="10"/>
                        </page>
                        <page string="Placeholders disponibles" name="help">
                            <div class="text-muted" style="padding: 8px;">
                                <p><b>${instance_name}</b> — nom de l'instance gérée</p>
                                <p><b>${client_name}</b> — nom du client (partenaire, sinon nom de l'instance)</p>
                                <p><b>${invoice_ref}</b> — référence de la facture générée au centre</p>
                                <p><b>${invoice_amount}</b> — montant de la facture</p>
                                <p><b>${invoice_currency}</b> — devise de la facture</p>
                                <p><b>${suspension_date}</b> — date de suspension prévue</p>
                                <p><b>${days_before}</b> — jours restants avant suspension</p>
                                <p><b>${db_name}</b> — nom de la base de l'instance gérée</p>
                                <p><b>${cycle_name}</b> — nom du cycle (ex. « Instance A – Octobre 2026 »)</p>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
