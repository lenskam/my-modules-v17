<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Valeurs par défaut des paramètres (modifiables dans Paramètres → Abonnement) -->
        <record id="param_billing_day" model="ir.config_parameter">
            <field name="key">subscription.billing_day</field>
            <field name="value">25</field>
        </record>
        <record id="param_payment_delay" model="ir.config_parameter">
            <field name="key">subscription.payment_delay_days</field>
            <field name="value">15</field>
        </record>
        <record id="param_reminder_days" model="ir.config_parameter">
            <field name="key">subscription.reminder_days</field>
            <field name="value">10,5,2,1</field>
        </record>
        <record id="param_suspension_alert" model="ir.config_parameter">
            <field name="key">subscription.suspension_alert</field>
            <field name="value">True</field>
        </record>
    </data>
</odoo>
