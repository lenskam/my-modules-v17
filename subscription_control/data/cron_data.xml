<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron job quotidien pour vérifier l'expiration -->
        <record id="cron_check_subscription_expiration" model="ir.cron">
            <field name="name">Vérification expiration abonnement</field>
            <field name="model_id" ref="model_subscription_control"/>
            <field name="code">model.block_access_if_expired()</field>
            <field name="state">code</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>

        <!-- Cron job quotidien : cycles de facturation, rappels et suspensions -->
        <record id="cron_billing_cycle" model="ir.cron">
            <field name="name">Cycles de facturation et rappels abonnement</field>
            <field name="model_id" ref="model_subscription_billing_cycle"/>
            <field name="code">model.run_billing_cycle()</field>
            <field name="state">code</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>

        <!-- Cron : expiration forcee des sessions utilisateur (toutes les 5 min) -->
        <record id="cron_check_expired_sessions" model="ir.cron">
            <field name="name">Expiration forcee des sessions abonnement</field>
            <field name="model_id" ref="model_subscription_session"/>
            <field name="code">model._check_expired_sessions()</field>
            <field name="state">code</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>

        <!-- Cron : synchronisation des paiements sur l'Odoo de facturation -->
        <record id="cron_sync_remote_payments" model="ir.cron">
            <field name="name">Synchro paiements abonnement (API Odoo facturation)</field>
            <field name="model_id" ref="model_subscription_billing_cycle"/>
            <field name="code">model._sync_remote_payments()</field>
            <field name="state">code</field>
            <field name="interval_number">4</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>