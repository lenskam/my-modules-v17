<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="subscription_control.SubscriptionAlertDialog" owl="1">
        <div class="o_dialog" t-att-id="id" t-att-class="{ o_inactive_modal: !data.isActive }">
            <div role="dialog" class="modal d-block o_technical_modal" tabindex="-1" t-ref="modalRef">
                <div class="modal-dialog" t-attf-class="modal-{{ props.size || 'md' }}">
                    <div class="modal-content">
                        <header class="modal-header">
                            <h4 class="modal-title text-break" t-esc="props.title || ''"/>
                            <button t-if="props.closable" type="button" class="btn-close"
                                    aria-label="Fermer" tabindex="-1" t-on-click="data.close"/>
                        </header>
                        <main class="modal-body">
                            <p class="mb-0" t-esc="props.message"/>
                        </main>
                        <footer class="modal-footer" t-if="props.closable">
                            <button class="btn btn-primary" t-on-click="data.close">Fermer</button>
                        </footer>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
